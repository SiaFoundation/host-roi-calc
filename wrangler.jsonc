{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "host-roi-calc",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "host-roi-calculator.sia.tools", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
